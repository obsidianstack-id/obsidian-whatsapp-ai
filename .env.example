# Required
ADMIN_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Server
PORT=8080
# One persistent root for both SQLite data and WhatsApp session files
STORAGE_DIR=./storage
# Optional legacy overrides (leave unset to use STORAGE_DIR/data and STORAGE_DIR/auth)
# DATA_DIR=./data
# AUTH_DIR=./auth
PUBLIC_BASE_URL=https://your-railway-domain.up.railway.app

# WhatsApp
WHATSAPP_ENABLED=true

# OpenRouter (can also be configured in Admin Panel)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Obsidian Stack WhatsApp AI

# Payment webhook shared secret. Configure the same secret at your provider if supported.
PAYMENT_WEBHOOK_SECRET=replace-this-webhook-secret

# Midtrans Snap credentials (Sandbox by default)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
